# Blaze.ai API access
# Generate a workspace key in Blaze: Workspace avatar > Settings > Integrations > New Key
BLAZE_API_KEY=

# Optional overrides (defaults shown). Set these once you have Blaze's real API details.
# BLAZE_API_BASE_URL=https://api.blaze.ai
# BLAZE_AUTH_STYLE=bearer            # 'bearer' or 'x-api-key'
# BLAZE_PATH_GENERATE=/v1/content/generate
# BLAZE_PATH_SCHEDULE=/v1/calendar/schedule
# BLAZE_PATH_CONTENT=/v1/content
# BLAZE_PATH_APPS=/v1/apps
